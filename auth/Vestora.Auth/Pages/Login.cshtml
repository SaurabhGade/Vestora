@page
@model Vestora.Auth.Pages.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Login | Vestora</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;

                display: flex;
                align-items: center;
                justify-content: center;

                background: rgba(93, 179, 236, 0.466);

                font-family:
                    Inter,
                    system-ui,
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    sans-serif;

                color: #1f2937;
            }

            .login-container {
                width: 100%;
                max-width: 420px;
                padding: 24px;
            }

            .login-card {
                background: rgba(93, 179, 236, 0.466);

                border-radius: 12px;

                padding: 40px;

                box-shadow:
                    0 10px 30px rgba(0, 0, 0, 0.08);
            }

            .brand {
                text-align: center;
                margin-bottom: 32px;
            }

            .brand h1 {
                margin: 0;

                font-size: 30px;
                font-weight: 700;
            }

            .brand p {
                margin-top: 8px;

                color: #6b7280;
                font-size: 14px;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;

                margin-bottom: 7px;

                font-size: 14px;
                font-weight: 500;
            }

            input {
                width: 100%;

                padding: 12px 14px;

                border: 1px solid #d1d5db;
                border-radius: 7px;

                font-size: 15px;

                outline: none;
            }

            input:focus {
                border-color: #111827;
            }

            button {
                width: 100%;

                padding: 12px;

                border: none;
                border-radius: 7px;

                background: #111827;
                color: white;

                font-size: 15px;
                font-weight: 600;

                cursor: pointer;
            }

            button:hover {
                background: #374151;
            }

            .validation {
                margin-bottom: 20px;

                color: #dc2626;
                font-size: 14px;
            }

            .footer {
                margin-top: 28px;

                text-align: center;

                color: #9ca3af;
                font-size: 12px;
            }

            .register-link {
                margin-top: 20px;
                text-align: center;
                font-size: 14px;
            }

            .register-link a {
                color: #111827;
                font-weight: 600;
            }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <div class="brand">

                <h1>Vestora</h1>

                <p>
                    Investment intelligence platform
                </p>

            </div>

            <form method="post">

                <div asp-validation-summary="ModelOnly" class="validation">
                </div>

                <div class="form-group">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email" placeholder="you@example.com" autocomplete="email" />

                </div>

                <div class="form-group">

                    <label asp-for="Password">
                        Password
                    </label>

                    <input asp-for="Password" placeholder="Enter your password" autocomplete="current-password" />

                </div>

                <input type="hidden" asp-for="ReturnUrl" />

                <button type="submit">
                    Sign in
                </button>
                <div class="register-link">
                    Don't have an account?
                    <a href="/Register">
                        Create an account
                    </a>
                </div>

            </form>

            <div class="footer">
                Vestora
            </div>

        </div>

    </div>

</body>

</html>