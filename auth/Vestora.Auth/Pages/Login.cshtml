@page
@model LoginModel

<!DOCTYPE html>

<html>
<head>
    <title>Vestora - Login</title>
</head>

<body>
    <h1>Vestora</h1>

    <h2>Login</h2>

    <form method="post">
        <div>
            <label>Email</label>
            <input asp-for="Email" type="email" />
        </div>

        <div>
            <label>Password</label>
            <input asp-for="Password" type="password" />
        </div>

        <button type="submit">
            Login
        </button>
    </form>
</body>
</html>
