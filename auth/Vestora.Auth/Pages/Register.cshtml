@page
@model Vestora.Auth.Pages.RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>Register | Vestora</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(93, 179, 236, 0.466);

            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            color: #1f2937;
        }

        .register-container {
            width: 100%;
            max-width: 520px;
            padding: 24px;
        }

        .register-card {
            background: rgba(93, 179, 236, 0.466);

            border-radius: 12px;

            padding: 40px;

            box-shadow:
                0 10px 30px
                rgba(0, 0, 0, 0.08);
        }

        .brand {
            text-align: center;
            margin-bottom: 30px;
        }

        .brand h1 {
            margin: 0;
            font-size: 30px;
        }

        .brand p {
            margin-top: 8px;
            color: #6b7280;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .row {
            display: flex;
            gap: 14px;
        }

        .row .form-group {
            flex: 1;
        }

        label {
            display: block;

            margin-bottom: 7px;

            font-size: 14px;
            font-weight: 500;
        }

        input {
            width: 100%;

            padding: 12px 14px;

            border: 1px solid #d1d5db;
            border-radius: 7px;

            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #111827;
        }

        button {
            width: 100%;

            padding: 12px;

            border: none;
            border-radius: 7px;

            background: #111827;
            color: white;

            font-size: 15px;
            font-weight: 600;

            cursor: pointer;
        }

        button:hover {
            background: #374151;
        }

        .validation {
            margin-bottom: 20px;

            color: #dc2626;
            font-size: 14px;
        }

        .login-link {
            margin-top: 20px;

            text-align: center;

            font-size: 14px;
        }

        .login-link a {
            color: #111827;
            font-weight: 600;
        }

    </style>

</head>

<body>

<div class="register-container">

    <div class="register-card">

        <div class="brand">

            <h1>Vestora</h1>

            <p>
                Create your investment account
            </p>

        </div>

        <form method="post">

            <div
                asp-validation-summary="All"
                class="validation">
            </div>

            <div class="row">

                <div class="form-group">

                    <label asp-for="FirstName">
                        First name
                    </label>

                    <input
                        asp-for="FirstName"
                        autocomplete="given-name" />

                </div>

                <div class="form-group">

                    <label asp-for="LastName">
                        Last name
                    </label>

                    <input
                        asp-for="LastName"
                        autocomplete="family-name" />

                </div>

            </div>

            <div class="form-group">

                <label asp-for="MiddleName">
                    Middle name
                </label>

                <input
                    asp-for="MiddleName" />

            </div>

            <div class="form-group">

                <label asp-for="Email">
                    Email
                </label>

                <input
                    asp-for="Email"
                    type="email"
                    autocomplete="email" />

            </div>

            <div class="form-group">

                <label asp-for="PhoneNumber">
                    Phone number
                </label>

                <input
                    asp-for="PhoneNumber"
                    type="tel"
                    autocomplete="tel" />

            </div>

            <div class="form-group">

                <label asp-for="DateOfBirth">
                    Date of birth
                </label>

                <input
                    asp-for="DateOfBirth"
                    type="date" />

            </div>

            <div class="form-group">

                <label asp-for="Password">
                    Password
                </label>

                <input
                    asp-for="Password"
                    type="password"
                    autocomplete="new-password" />

            </div>

            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm password
                </label>

                <input
                    asp-for="ConfirmPassword"
                    type="password"
                    autocomplete="new-password" />

            </div>

            <button type="submit">
                Create account
            </button>

        </form>

        <div class="login-link">

            Already have an account?

            <a href="/Login">
                Sign in
            </a>

        </div>

    </div>

</div>

</body>

</html>